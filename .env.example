# Copy this file to `.env` for local development: `cp .env.example .env`.
# Never commit real credentials. Production must provide these through the
# deployment environment or a secret store.

# --- Core ---------------------------------------------------------------
# development | test | production
ENV=development
APP_NAME=Enrollio
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Data stores --------------------------------------------------------
# Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://enrollio:enrollio@localhost:5432/enrollio
# Integration tests use this database, never DATABASE_URL. Its name must end
# with `_test`; destructive migration tests refuse to run otherwise.
TEST_DATABASE_URL=postgresql+asyncpg://enrollio:enrollio@localhost:5432/enrollio_test
# Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# --- Authentication -----------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Failed logins allowed inside the window before the account is locked.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Argon2id parameters. Lower them only for tests, never for production.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Comma-separated browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# --- Seed data ----------------------------------------------------------
# Create the three demo accounts in non-production environments.
SEED_DEMO_USERS=true
# Development-only password for admin/manager/counsellor @enrollio.dev.
SEED_DEMO_PASSWORD=dev-only-password

# --- LLM ----------------------------------------------------------------
# mock | openai | anthropic
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=mock
# Optional OpenAI-compatible gateway base URL.
LLM_BASE_URL=

# --- Email --------------------------------------------------------------
# mock | ses | sendgrid | resend
EMAIL_PROVIDER=mock
# SendGrid or Resend Bearer API key, depending on EMAIL_PROVIDER.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@enrollio.dev
EMAIL_FROM_NAME=Enrollio
# Replies are routed to reply+{token}@<EMAIL_REPLY_DOMAIN>.
EMAIL_REPLY_DOMAIN=reply.example.test
# SendGrid: Inbound Parse authenticates with Basic auth, username `sendgrid`,
# and this secret as the password.
# Resend: this is the Svix signing secret (`whsec_...`) for `email.received`
# webhooks; the adapter fetches the body via /emails/receiving/{id}.
EMAIL_WEBHOOK_SECRET=

# --- Messaging guards (M3.3) --------------------------------------------
# Non-urgent (promotional) sends inside the quiet window are queued until it
# ends. Window may wrap midnight (start 21, end 9).
QUIET_HOURS_START_HOUR=21
QUIET_HOURS_END_HOUR=9
QUIET_HOURS_TIMEZONE=Asia/Kolkata
# Promotional frequency cap per student across the rolling window.
PROMOTIONAL_CAP_PER_WINDOW=2
PROMOTIONAL_CAP_WINDOW_DAYS=7
# Appended to every rendered promotional message (AC4.2).
UNSUBSCRIBE_URL=https://enrollio.example/unsubscribe

# --- Campaigns (M3.5) ----------------------------------------------------
# Launches larger than this many recipients require approval before sending.
CAMPAIGN_LAUNCH_APPROVAL_THRESHOLD=500
# inline | celery — inline runs the batch in the request; celery enqueues it.
CAMPAIGN_SEND_MODE=inline

# --- WhatsApp (Phase 2 stub) -------------------------------------------
# mock | cloud_api
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Calendar -----------------------------------------------------------
# mock | google
CALENDAR_PROVIDER=mock
CALENDAR_API_KEY=

# --- Speech-to-text -----------------------------------------------------
# mock | whisper_local | whisper_api
SPEECH_PROVIDER=mock
SPEECH_API_KEY=

# --- Object storage -----------------------------------------------------
# local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=enrollio
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Lead imports -------------------------------------------------------
# Maximum data rows accepted in one CSV/XLSX upload.
IMPORT_MAX_ROWS=10000
# Maximum upload size in bytes (10 MiB).
IMPORT_MAX_FILE_BYTES=10485760
# celery | inline. Inline is useful for tests and single-process development.
IMPORT_PROCESSING_MODE=celery

# --- Consent ------------------------------------------------------------
# Close active leads as Opted Out when no granted promotional consent remains.
CONSENT_PROMOTIONAL_OPT_OUT_LIFECYCLE=true

# --- Public enquiries ---------------------------------------------------
# Fixed-window rate limit per client IP for POST /api/public/enquiries.
ENQUIRY_RATE_LIMIT_PER_HOUR=10
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600
# The mock accepts any non-empty token except "invalid". Replace with a real
# verifier before exposing the public form in production.
USE_MOCK_CAPTCHA=true

# --- Partner API ingestion ---------------------------------------------
# Maximum leads accepted in one POST /api/integrations/leads request.
API_INGESTION_MAX_RECORDS=1000

# --- Provider mode flags ------------------------------------------------
# When true the in-process mock adapter is used and no credentials are needed.
# Set to false only for a real integration.
USE_MOCK_EMAIL=true
USE_MOCK_WHATSAPP=true
USE_MOCK_CALENDAR=true
USE_MOCK_LLM=true
USE_MOCK_SPEECH=true
USE_MOCK_STORAGE=true
